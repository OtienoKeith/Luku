# Public mobile configuration only. Never put YOUCAM_API_TOKEN here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Exact reachable endpoint, including /try-on.
# Stable hosted endpoint used by the judge build:
EXPO_PUBLIC_YOUCAM_FUNCTION_URL=https://luku-judge-api.otienomkeith.workers.dev/try-on

# Backend-only image discovery credentials. Put these in supabase/.env.local,
# never in the mobile .env file or APK.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Must be registered exactly in the Pinterest developer console.
PINTEREST_REDIRECT_URI=https://luku-judge-api.otienomkeith.workers.dev/pinterest/callback
