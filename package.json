{
  "name": "luku",
  "version": "1.1.12",
  "description": "Android-first AI virtual try-on powered by Perfect Corp. YouCam APIs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OtienoKeith/Luku.git"
  },
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "backend": "node server/youcam-local.mjs",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm worker:typecheck && node --check server/youcam-local.mjs",
    "worker:typecheck": "tsc -p tsconfig.worker.json",
    "worker:deploy": "wrangler deploy",
    "doctor": "pnpm dlx expo-doctor",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "^6.1.2",
    "@expo/vector-icons": "latest",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-camera": "~17.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "^14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-media-library": "~18.2.1",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "^6.0.9",
    "expo-web-browser": "~15.0.11",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "^15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.15.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.17",
    "typescript": "~5.9.3",
    "wrangler": "^4.123.0"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "@expo/dom-webview"
      ],
      "searchPaths": [
        "./node_modules"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "private": true
}
